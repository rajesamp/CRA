# Copy to .env and keep ONE option active (never commit .env).

# Option A: Gemini API key (no GCP access needed).
# Create a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_ENTERPRISE=False
GOOGLE_API_KEY=YOUR_API_KEY

# Option B: Vertex AI in your own GCP project.
# Comment out Option A above, uncomment these three lines, then run:
#   gcloud auth application-default login
# GOOGLE_GENAI_USE_ENTERPRISE=True
# GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
# GOOGLE_CLOUD_LOCATION=us-central1
